# Server
PORT=5000
NODE_ENV=development

# Database (local MongoDB or MongoDB Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/lmcc

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d

# CORS / client origin (comma separated allowed origins)
CLIENT_URL=http://localhost:5173

# Cloudinary (leave blank to store images on local disk under server/uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# OCR provider: tesseract | demo | remote (python microservice) 
OCR_PROVIDER=tesseract
# Remote OCR service base URL when OCR_PROVIDER=remote
OCR_SERVICE_URL=
OCR_API_KEY=

# SMTP (optional; if blank, emails are logged to console only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="LMCC Platform <no-reply@lmcc.gov.in>"

# Development convenience ONLY: return reset token in API response when SMTP is not configured
EXPOSE_RESET_TOKEN_IN_DEV=true

# Public base URL of this server (used for locally stored asset links in reports)
SERVER_BASE_URL=http://localhost:5000
