{
  "name": "lmcc-server",
  "version": "1.0.0",
  "private": true,
  "description": "Legal Metrology Compliance Platform - API server",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_TLS_REJECT_UNAUTHORIZED=0 nodemon server.js",
    "start": "node server.js",
    "seed": "node seeds/seed.js",
    "test": "cross-env NODE_ENV=test jest --runInBand",
    "test:integration": "cross-env NODE_ENV=test jest --runInBand --testMatch=\"**/tests/**/*.integration.test.js\""
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.4.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jimp": "^0.22.12",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.6.0",
    "mongoose": "^8.5.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.14",
    "pdfkit": "^0.15.0",
    "tesseract.js": "^5.1.1"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.1",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.unit.test.js"
    ]
  },
  "engines": {
    "node": ">=18"
  }
}
